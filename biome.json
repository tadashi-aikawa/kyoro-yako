{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": { "includes": ["src/**", "*.ts", "*.json", "*.html", "*.css", "!pnpm-lock.yaml"] },
  "formatter": { "enabled": false },
  "linter": {
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noExplicitAny": "off" }
    }
  }
}
